# On your own server only DOMAIN, ADMIN_PASSWORD and SESSION_SECRET need to live here (on Vercel, also
# the Turso and Blob lines below). Everything else can be
# set from the website instead: /admin → Settings. A value set here overrides the admin page.

# ─── Required ────────────────────────────────────────────────────────────────
# Your domain (used by docker-compose and Caddy for HTTPS).
DOMAIN=rishikesh.suhmantics.com
# Password for /admin. Make it long.
ADMIN_PASSWORD=
# Any long random string (signs the admin login cookie).  e.g.  openssl rand -hex 32
SESSION_SECRET=

# ─── Hosting on Vercel (no disk that survives between requests) ─────────────
# The database, hosted by Turso (free plan). Leave empty to use a SQLite file in DATA_DIR.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Flyer photos in Vercel Blob. Added for you when a Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# ─── Who organisers contact (shown on "Post a flyer" and "How it works") ────
OWNER_NAME=
# Your WhatsApp number with country code, e.g. +919876543210
OWNER_WHATSAPP=

# ─── Flyer auto-fill (reads date/time/price from the photo) ─────────────────
# From https://console.anthropic.com → API keys. Leave empty to fill forms by hand.
ANTHROPIC_API_KEY=

# ─── Email alerts (follower alerts, daily digest, organiser links) ──────────
# From https://resend.com (free tier). Verify suhmantics.com in Resend first.
RESEND_API_KEY=
EMAIL_FROM=Pinned Rishikesh <alerts@suhmantics.com>

# ─── Payments ────────────────────────────────────────────────────────────────
# cash (launch default) | upi | razorpay
PAYMENTS_MODE=cash
# upi mode: your UPI ID, shown as a QR code
UPI_ID=
UPI_PAYEE_NAME=
# razorpay mode: from Razorpay Dashboard → API Keys / Webhooks
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Optional ────────────────────────────────────────────────────────────────
# Listing price in paise (5000 = ₹50) and length in days.
LISTING_PRICE_PAISE=5000
LISTING_DAYS=28
# Lets a scheduler call /api/cron (your own server already runs the jobs itself). On Vercel, Vercel Cron
# sends it for you.
CRON_SECRET=
# The GitHub repo (owner/name) whose Actions may call /api/cron with a GitHub-signed token instead of
# CRON_SECRET — how .github/workflows/jobs.yml runs the jobs every 15 minutes with nothing stored in GitHub.
CRON_GITHUB_REPO=
# Map tiles. Default is OpenStreetMap; swap for MapTiler/Stadia if traffic grows.
# NEXT_PUBLIC_MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
